<?xml version='1.0' encoding='utf-8'?>
<sentence_maps schema_version="1">
  <sentence_patterns>
    <sentence_pattern id="Sam czasownik" category="basic">
      <question>{context.translation}{verb[form].translation}.</question>
      <answer>{context.kana}{verb[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Czasownik z dopełnieniem" category="basic">
      <question>{context.translation}{verb[role:object][form].translation} {noun[government:phrase]}.</question>
      <answer>{context.kana}{noun}を{verb[role:object][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Opisane dopełnienie" category="basic">
      <question>{context.translation}{verb@object[role:object][form].translation} {noun@object[government:preposition]}{adjective@object[form:attributive_nonpast][agree].translation} {noun@object[government:case]}.</question>
      <answer>{context.kana}{adjective@object[form:attributive_nonpast]}{noun@object}を{verb@object[role:object][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Cel ruchu" category="movement">
      <question>{context.translation}{verb[role:destination][form].translation} {noun[category:place][relation:destination]}.</question>
      <answer>{context.kana}{noun[category:place]}へ{verb[role:destination][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Towarzysz" category="movement">
      <question>{context.translation}{verb@companion[role:companion][form].translation} {noun@companion[government:phrase]}.</question>
      <answer>{context.kana}{noun@companion}と{verb@companion[role:companion][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Miejsce czynności" category="movement">
      <question>{context.translation}{verb[role:location][form].translation} {noun[category:place][relation:location]}.</question>
      <answer>{context.kana}{noun[category:place]}で{verb[role:location][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Środek transportu" category="movement">
      <question>{context.translation}{verb@vehicle[role:vehicle][form].translation} {noun@vehicle[category:vehicle][government:phrase]}.</question>
      <answer>{context.kana}{noun@vehicle[category:vehicle]}に{verb@vehicle[role:vehicle][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Przymiotnik po temacie" category="adjectives">
      <question>{noun[case:nominative]} {adjective[form][agree].translation}.</question>
      <answer>この{noun}は{adjective[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Sam przymiotnik" category="adjectives">
      <question>To {adjective[form][agree:neuter].translation}.</question>
      <answer>これは{adjective[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Przymiotnik przed rzeczownikiem" category="adjectives">
      <question>To {copula[form][agree].translation} {adjective[form:attributive_nonpast][agree].translation} {noun[case:nominative]}.</question>
      <answer>これは{adjective[form:attributive_nonpast]}{noun}{copula[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Cytowana opinia" category="constructions">
      <question>{verb[feature:reporting][form].translation}, że {noun[case:nominative]} {adjective[form:predicate_plain_nonpast][agree].translation}.</question>
      <answer>あの{noun}が{adjective[form:predicate_plain_nonpast]}と{verb[feature:reporting][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Przed inną czynnością" category="constructions">
      <question>{context[from:main].translation}{verb@main[role:object][form].translation} {noun[government:phrase]}, zanim {verb@before[form][polarity:affirmative].translation}.</question>
      <answer>{context[from:main].kana}{verb@before[form:dictionary]}まえに{noun}を{verb@main[role:object][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Trzy lubiane rzeczy" category="basic">
      <question>{context.translation}Lubię {noun@first[case:accusative]}, {noun@second[case:accusative]} i {noun@third[case:accusative]}.</question>
      <answer>{context.kana}{noun@first}と{noun@second}と{noun@third}がすきです</answer>
    </sentence_pattern>
    <sentence_pattern id="Reakcja na przyczynę" category="basic">
      <question>{context.translation}{verb@reaction[role:reaction_target][form].translation} {noun@reaction[government:phrase]}.</question>
      <answer>{context.kana}{noun@reaction}に{verb@reaction[role:reaction_target][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Dostępność 〜がある" category="constructions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
      </patterns>
      <question>{context[from:main].translation}{verb@main[id:aru][form].translation} {noun@main[category:availability_reason][government:phrase]}, żeby {pattern[form:dictionary][translation:base][case_scope:embedded]}.</question>
      <answer>{context[from:main].kana}{pattern[form:dictionary][case_scope:embedded]}{noun@main[category:availability_reason]}が{verb@main[id:aru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Możliwość ことができる" category="constructions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Miejsce czynności" />
      </patterns>
      <question>{context[from:main].translation}{verb@main[id:dekiru][form].translation} {pattern[form:dictionary][translation:base]}.</question>
      <answer>{context[from:main].kana}{pattern[form:dictionary]}ことが{verb@main[id:dekiru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Czynność w toku 〜ている" category="constructions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
      </patterns>
      <question>{context[from:main].translation}{pattern[form:te_form]}.</question>
      <answer>{context[from:main].kana}{pattern[form:te_form]}{verb@main[id:iru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o miejsce" category="questions">
      <question>Gdzie {context.translation}{verb[role:location][form].translation}?</question>
      <answer>{context.kana}{interrogative[asks_for:place]}で{verb[role:location][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o cel" category="questions">
      <question>Dokąd {context.translation}{verb[role:destination][form].translation}?</question>
      <answer>{context.kana}{interrogative[asks_for:place]}へ{verb[role:destination][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o towarzysza" category="questions">
      <question>{interrogative@companion[id:dare].translation} {context.translation}{verb@companion[role:companion][form].translation}?</question>
      <answer>{context.kana}{interrogative@companion}と{verb@companion[role:companion][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o rzecz" category="questions">
      <question>{interrogative@object[id:nani].translation} {context.translation}{verb@object[role:object][form].translation}?</question>
      <answer>{context.kana}{interrogative@object}を{verb@object[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie który + rzeczownik" category="questions">
      <question>{interrogative[asks_for:choice_modifier][agree].translation} {noun[case:nominative]} to {copula[form][agree].translation}?</question>
      <answer>{interrogative[asks_for:choice_modifier]}{noun}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o rodzaj" category="questions">
      <question>{interrogative[asks_for:kind][agree].translation} to {copula[form][agree].translation} {noun[case:nominative]}?</question>
      <answer>{interrogative[asks_for:kind]}{noun}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie czyj" category="questions">
      <question>{interrogative[asks_for:possessor][agree].translation} {noun[category:concrete][case:nominative]} to {copula[form][agree].translation}?</question>
      <answer>これは{interrogative[asks_for:possessor]}{noun[category:concrete]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie jak" category="questions">
      <question>{interrogative[asks_for:manner][agree].translation} {copula[form][agree].translation} {noun[case:nominative]}?</question>
      <answer>{noun}は{interrogative[asks_for:manner]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie ile kosztuje" category="questions">
      <question>{interrogative[asks_for:price][agree].translation} {noun[category:purchasable][case:nominative]}?</question>
      <answer>{noun[category:purchasable]}は{interrogative[asks_for:price]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie ile osób" category="questions">
      <question>Ile osób jest {noun[category:place][relation:location]}?</question>
      <answer>{noun[category:place]}に{interrogative[asks_for:people_count]}{verb[id:iru][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie ile lat" category="questions">
      <question>Ile lat ma {noun[category:person][case:nominative]}?</question>
      <answer>{noun[category:person]}は{interrogative[asks_for:age]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie kiedy" category="questions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
        <pattern ref="Środek transportu" />
      </patterns>
      <question>Kiedy {pattern}?</question>
      <answer>{interrogative[id:itsu]}{pattern}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o godzinę" category="questions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
        <pattern ref="Środek transportu" />
      </patterns>
      <question>O której godzinie {pattern}?</question>
      <answer>{interrogative[id:nanji]}に{pattern}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie dlaczego" category="questions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
        <pattern ref="Środek transportu" />
      </patterns>
      <question>Dlaczego {context.translation}{pattern}?</question>
      <answer>{context.kana}{interrogative[asks_for:reason]}{pattern}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie jakim sposobem" category="questions">
      <patterns>
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
        <pattern ref="Środek transportu" />
      </patterns>
      <question>W jaki sposób {context.translation}{pattern}?</question>
      <answer>{context.kana}{interrogative[asks_for:method]}{pattern}{question}</answer>
    </sentence_pattern>
  </sentence_patterns>
</sentence_maps>
