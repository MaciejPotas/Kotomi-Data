<?xml version='1.0' encoding='utf-8'?>
<sentence_maps schema_version="1">
  <sentence_patterns>
    <sentence_pattern id="Sam czasownik">
      <question>{context.translation}{verb[form].translation}.</question>
      <answer>{context.kana}{verb[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Czasownik z dopełnieniem">
      <question>{context.translation}{verb[role:object][form].translation} {noun[case:accusative]}.</question>
      <answer>{context.kana}{noun}を{verb[role:object][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Opisane dopełnienie">
      <question>{context.translation}{verb[role:object][form].translation} {adjective[form:attributive_nonpast].translation} {noun[case:accusative]}.</question>
      <answer>{context.kana}{adjective[form:attributive_nonpast]}{noun}を{verb[role:object][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Cel ruchu">
      <question>{context.translation}{verb[role:destination][form].translation} do {noun[category:place][case:genitive]}.</question>
      <answer>{context.kana}{noun[category:place]}へ{verb[role:destination][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Towarzysz">
      <question>{context.translation}{verb[role:companion][form].translation} z {noun[case:instrumental]}.</question>
      <answer>{context.kana}{noun}と{verb[role:companion][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Miejsce czynności">
      <question>{context.translation}{verb[role:location][form].translation} w {noun[category:place][case:locative]}.</question>
      <answer>{context.kana}{noun[category:place]}で{verb[role:location][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Środek transportu">
      <question>{context.translation}{verb[role:vehicle][form].translation} {noun[category:vehicle][case:instrumental]}.</question>
      <answer>{context.kana}{noun[category:vehicle]}に{verb[role:vehicle][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Podmiot z が">
      <question>{context.translation}{noun[case:nominative]} {verb[role:subject][form].translation}.</question>
      <answer>{context.kana}{noun}が{verb[role:subject][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Przymiotnik po temacie">
      <question>{noun[case:nominative]} {adjective[form].translation}.</question>
      <answer>この{noun}は{adjective[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Sam przymiotnik">
      <question>To {adjective[form].translation}.</question>
      <answer>これは{adjective[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Przymiotnik przed rzeczownikiem">
      <question>To {copula[form].translation} {adjective[form:attributive_nonpast].translation} {noun[case:nominative]}.</question>
      <answer>これは{adjective[form:attributive_nonpast]}{noun}{copula[form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Cytowana opinia">
      <question>{verb[feature:reporting][form].translation}, że {noun[case:nominative]} {adjective[form:predicate_plain_nonpast].translation}.</question>
      <answer>あの{noun}が{adjective[form:predicate_plain_nonpast]}と{verb[feature:reporting][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Czynność w toku">
      <question>{context[from:main].translation}{verb[role:object][form].translation} {noun[case:accusative]}.</question>
      <answer>{context[from:main].kana}{noun}を{verb[role:object][form:te_form]}{verb@main[id:iru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Przed inną czynnością">
      <question>{context[from:main].translation}{verb@main[role:object][form].translation} {noun[case:accusative]} przed {verb@before[form].translation}.</question>
      <answer>{context[from:main].kana}{verb@before[form:dictionary]}まえに{noun}を{verb@main[role:object][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Trzy lubiane rzeczy">
      <question>{context.translation}Lubię {noun@first[case:accusative]}, {noun@second[case:accusative]} i {noun@third[case:accusative]}.</question>
      <answer>{context.kana}{noun@first}と{noun@second}と{noun@third}がすきです</answer>
    </sentence_pattern>
    <sentence_pattern id="Reakcja na przyczynę">
      <question>{context.translation}{verb[role:reaction_target][form].translation} {noun[case:instrumental]}</question>
      <answer>{noun}に{verb[role:reaction_target][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Dostępność 〜がある">
      <patterns form="dictionary" translation="base">
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
      </patterns>
      <question>{context[from:main].translation}{verb@main[id:aru][form].translation} {noun[category:availability_reason][case:accusative]}, żeby {pattern}.</question>
      <answer>{context[from:main].kana}{pattern}{noun[category:availability_reason]}が{verb@main[id:aru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Możliwość ことができる">
      <patterns form="dictionary" translation="base">
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Miejsce czynności" />
      </patterns>
      <question>{context[from:main].translation}{verb@main[id:dekiru][form].translation} {pattern}.</question>
      <answer>{context[from:main].kana}{pattern}ことが{verb@main[id:dekiru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Czynność w toku 〜ている">
      <patterns form="te_form">
        <pattern ref="Sam czasownik" />
        <pattern ref="Czasownik z dopełnieniem" />
        <pattern ref="Cel ruchu" />
        <pattern ref="Towarzysz" />
        <pattern ref="Miejsce czynności" />
      </patterns>
      <question>{context[from:main].translation}{pattern}.</question>
      <answer>{context[from:main].kana}{pattern}{verb@main[id:iru][form]}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o miejsce">
      <question>Gdzie {context.translation}{verb[role:location][form].translation}?</question>
      <answer>{interrogative[asks_for:place]}で{verb[role:location][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o cel">
      <question>Dokąd {context.translation}{verb[role:destination][form].translation}?</question>
      <answer>{interrogative[asks_for:place]}へ{verb[role:destination][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o towarzysza">
      <question>Z kim {context.translation}{verb[role:companion][form].translation}?</question>
      <answer>{interrogative[asks_for:person]}と{verb[role:companion][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie kiedy">
      <question>Kiedy {context.translation}{verb[form].translation}?</question>
      <answer>{interrogative[asks_for:time]}{verb[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie dlaczego">
      <question>Dlaczego {context.translation}{verb[form].translation}?</question>
      <answer>{interrogative[asks_for:reason]}{verb[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie jak">
      <question>Jak {context.translation}{verb[form].translation}?</question>
      <answer>{interrogative[asks_for:method]}{verb[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie o rzecz">
      <question>Co {context.translation}{verb[role:object][form].translation}?</question>
      <answer>{interrogative[id:nani]}を{verb[role:object][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie kto">
      <question>Kto to jest?</question>
      <answer>これは{interrogative[asks_for:person]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie co">
      <question>Co to jest?</question>
      <answer>これは{interrogative[id:nan]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie który">
      <question>Który to jest?</question>
      <answer>{interrogative[asks_for:choice]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie czyj">
      <question>Czyje to jest?</question>
      <answer>これは{interrogative[asks_for:possessor]}{copula[form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie ile">
      <question>Ile ich jest?</question>
      <answer>{interrogative[asks_for:quantity]}{verb[id:aru][form]}{question}</answer>
    </sentence_pattern>
    <sentence_pattern id="Pytanie ile kosztuje">
      <question>Ile to kosztuje?</question>
      <answer>これは{interrogative[asks_for:price]}{copula[form]}{question}</answer>
    </sentence_pattern>
  </sentence_patterns>
</sentence_maps>