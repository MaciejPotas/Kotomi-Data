      <variant terminal="unit" value="10" remove_kana="じゅう" kana="じゅっぴき" remove_kanji="十" kanji="十匹" remove_romaji="juu" romaji="juppiki" />
      <variant terminal="unit" value="100" remove_kana="く" kana="っぴき" kanji="匹" remove_romaji="ku" romaji="ppiki" />
