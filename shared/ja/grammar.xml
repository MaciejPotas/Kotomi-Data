<?xml version='1.0' encoding='utf-8'?>
<grammar_rules schema_version="2" target_language_id="ja">
  <noun_categories>
    <category id="concrete" selectable="false" />
    <category id="person" parent="concrete" selectable="true" />
    <category id="animal" parent="concrete" selectable="true" />
    <category id="place" parent="concrete" selectable="true" />
    <category id="purchasable" parent="concrete" selectable="false" />
    <category id="food" parent="purchasable" selectable="true" />
    <category id="drink" parent="purchasable" selectable="true" />
    <category id="text" parent="purchasable" selectable="true" />
    <category id="media" parent="purchasable" selectable="true" />
    <category id="vehicle" parent="purchasable" selectable="true" />
    <category id="thing" parent="purchasable" selectable="true" />
    <category id="item" parent="thing" selectable="true" />
    <category id="abstract" selectable="true" />
    <category id="availability_reason" parent="abstract" selectable="true" />
  </noun_categories>
  <form_catalogs>
    <form_catalog schema="verb">
      <form name="dictionary" context="present" polarity="affirmative" register="plain" />
      <form name="polite_nonpast" context="present" polarity="affirmative" register="polite" />
      <form name="plain_negative" context="present" polarity="negative" register="plain" />
      <form name="polite_negative" context="present" polarity="negative" register="polite" />
      <form name="past_plain" context="past" polarity="affirmative" register="plain" />
      <form name="past_polite" context="past" polarity="affirmative" register="polite" />
      <form name="past_negative_plain" context="past" polarity="negative" register="plain" />
      <form name="past_negative_polite" context="past" polarity="negative" register="polite" />
      <form name="te_form" context="none" />
      <form name="potential" context="none" />
      <form name="passive" context="none" />
      <form name="causative" context="none" />
      <form name="tara" context="none" />
      <form name="volitional" context="none" />
      <form name="imperative" context="none" />
    </form_catalog>
    <form_catalog schema="adjective">
      <form name="predicate_plain_nonpast" context="present" polarity="affirmative" register="plain" />
      <form name="predicate_polite_nonpast" context="present" polarity="affirmative" register="polite" />
      <form name="predicate_plain_negative" context="present" polarity="negative" register="plain" />
      <form name="predicate_polite_negative" context="present" polarity="negative" register="polite" />
      <form name="predicate_plain_past" context="past" polarity="affirmative" register="plain" />
      <form name="predicate_polite_past" context="past" polarity="affirmative" register="polite" />
      <form name="predicate_plain_past_negative" context="past" polarity="negative" register="plain" />
      <form name="predicate_polite_past_negative" context="past" polarity="negative" register="polite" />
      <form name="attributive_nonpast" context="none" />
      <form name="connective" context="none" />
      <form name="adverbial" context="none" />
      <form name="conditional" context="none" />
      <form name="nominalized" context="none" />
      <form name="appearance_sou" context="none" />
      <form name="excessive_sugiru" context="none" />
    </form_catalog>
    <form_catalog schema="copula">
      <form name="dictionary" context="present" polarity="affirmative" register="plain" />
      <form name="polite_nonpast" context="present" polarity="affirmative" register="polite" />
      <form name="plain_negative" context="present" polarity="negative" register="plain" />
      <form name="polite_negative" context="present" polarity="negative" register="polite" />
      <form name="past_plain" context="past" polarity="affirmative" register="plain" />
      <form name="past_polite" context="past" polarity="affirmative" register="polite" />
      <form name="past_negative_plain" context="past" polarity="negative" register="plain" />
      <form name="past_negative_polite" context="past" polarity="negative" register="polite" />
    </form_catalog>
  </form_catalogs>
  <question_form_rules>
    <rule asks_for="manner" polarities="affirmative" />
    <rule asks_for="price" contexts="present" polarities="affirmative" />
    <rule asks_for="people_count" contexts="present" polarities="affirmative" />
    <rule asks_for="age" contexts="present" polarities="affirmative" />
    <rule asks_for="count" contexts="present" polarities="affirmative" />
  </question_form_rules>
  <roles>
    <role id="object" particle="を" />
    <role id="route" particle="を" accepts="place" />
    <role id="location" particle="で" accepts="place" />
    <role id="destination" particle="へ" accepts="place" />
    <role id="companion" particle="と" accepts="person animal" />
    <role id="target" particle="に" />
    <role id="vehicle" particle="に" accepts="vehicle" />
    <role id="subject" particle="が" />
    <role id="reaction_target" particle="に" />
  </roles>
  <features>
    <feature id="reporting" />
    <feature id="progressive_auxiliary" />
    <feature id="existential" />
  </features>
</grammar_rules>