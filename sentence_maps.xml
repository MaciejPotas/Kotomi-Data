<?xml version='1.0' encoding='utf-8'?>
<sentence_maps schema_version="13">
  <sentence_patterns>
    <sentence_pattern id="simple" label="Sam czasownik">
      <question>{context[.translation]}{verb[form.translation]}.</question>
      <answer>{context[.kana]}{verb}</answer>
    </sentence_pattern>
    <sentence_pattern id="transitive_object" label="Czasownik z dopełnieniem">
      <question>{context[.translation]}{verb[role:object][form.translation]} {noun[case:accusative]}.</question>
      <answer>{context[.kana]}{noun}を{verb[role:object]}</answer>
    </sentence_pattern>
    <sentence_pattern id="described_object_action" label="Opisane dopełnienie">
      <question>{context[.translation]}{verb[role:object][form.translation]} {adjective[form:attributive_nonpast.translation]} {noun[case:accusative]}.</question>
      <answer>{context[.kana]}{adjective[form:attributive_nonpast]}{noun}を{verb[role:object]}</answer>
    </sentence_pattern>
    <sentence_pattern id="destination" label="Cel ruchu">
      <question>{context[.translation]}{verb[role:destination][form.translation]} do {noun[category:place][case:genitive]}.</question>
      <answer>{context[.kana]}{noun[category:place]}へ{verb[role:destination]}</answer>
    </sentence_pattern>
    <sentence_pattern id="companion" label="Towarzysz">
      <question>{context[.translation]}{verb[role:companion][form.translation]} z {noun[case:instrumental]}.</question>
      <answer>{context[.kana]}{noun}と{verb[role:companion]}</answer>
    </sentence_pattern>
    <sentence_pattern id="place" label="Miejsce czynności">
      <question>{context[.translation]}{verb[role:location][form.translation]} w {noun[category:place][case:locative]}.</question>
      <answer>{context[.kana]}{noun[category:place]}で{verb[role:location]}</answer>
    </sentence_pattern>
    <sentence_pattern id="vehicle" label="Środek transportu">
      <question>{context[.translation]}{verb[role:vehicle][form.translation]} {noun[category:vehicle][case:instrumental]}.</question>
      <answer>{context[.kana]}{noun[category:vehicle]}に{verb[role:vehicle]}</answer>
    </sentence_pattern>
    <sentence_pattern id="subject" label="Podmiot z が">
      <question>{context[.translation]}{noun[case:nominative]} {verb[role:subject][form.translation]}.</question>
      <answer>{context[.kana]}{noun}が{verb[role:subject]}</answer>
    </sentence_pattern>
    <sentence_pattern id="adjective_predicate" label="Przymiotnik po temacie">
      <question>{noun[case:nominative]} {adjective[form.translation]}.</question>
      <answer>この{noun}は{adjective}</answer>
    </sentence_pattern>
    <sentence_pattern id="adjective_simple" label="Sam przymiotnik">
      <question>To {adjective[form.translation]}.</question>
      <answer>これは{adjective}</answer>
    </sentence_pattern>
    <sentence_pattern id="adjective_attributive" label="Przymiotnik przed rzeczownikiem">
      <question>To {copula[form.translation]} {adjective[form:attributive_nonpast.translation]} {noun[case:nominative]}.</question>
      <answer>これは{adjective[form:attributive_nonpast]}{noun}{copula}</answer>
    </sentence_pattern>
    <sentence_pattern id="quoted_predicate" label="Cytowana opinia">
      <question>{verb[feature:reporting][form.translation]}, że {noun[case:nominative]} {adjective[form:predicate_plain_nonpast.translation]}.</question>
      <answer>あの{noun}が{adjective[form:predicate_plain_nonpast]}と{verb[feature:reporting]}</answer>
    </sentence_pattern>
    <sentence_pattern id="te_iru_object" label="Czynność w toku">
      <question>{context[.translation]}{verb[role:object][form.translation]} {noun[case:accusative]}.</question>
      <answer>{context[.kana]}{noun}を{verb[role:object][form:te_form]}{verb[id:iru]}</answer>
    </sentence_pattern>
    <sentence_pattern id="before_action" label="Przed inną czynnością">
      <question>{context[.translation]}{verb[slot:main][role:object][form.translation]} {noun[case:accusative]} przed {verb[slot:before][form.translation]}.</question>
      <answer>{context[.kana]}{verb[slot:before][form:dictionary]}まえに{noun}を{verb[slot:main][role:object]}</answer>
    </sentence_pattern>
    <sentence_pattern id="three_nouns_suki" label="Trzy lubiane rzeczy">
      <question>{context[.translation]}Lubię {noun[slot:first][case:accusative]}, {noun[slot:second][case:accusative]} i {noun[slot:third][case:accusative]}.</question>
      <answer>{context[.kana]}{noun[slot:first]}と{noun[slot:second]}と{noun[slot:third]}がすきです</answer>
    </sentence_pattern>
    <sentence_pattern id="verb_noun_ga_aru" label="Dostępność 〜がある">
      <patterns form="dictionary" translation="base">
        <pattern ref="simple" />
        <pattern ref="transitive_object" />
        <pattern ref="destination" />
        <pattern ref="companion" />
        <pattern ref="place" />
      </patterns>
      <question>{context[.translation]}{verb[id:aru][form.translation]} {noun[category:availability_reason][case:accusative]}, żeby {pattern}.</question>
      <answer>{context[.kana]}{pattern}{noun[category:availability_reason]}が{verb[id:aru]}</answer>
    </sentence_pattern>
    <sentence_pattern id="koto_ga_dekiru" label="Możliwość ことができる">
      <patterns form="dictionary" translation="base">
        <pattern ref="simple" />
        <pattern ref="transitive_object" />
        <pattern ref="place" />
      </patterns>
      <question>{context[.translation]}{verb[id:dekiru][form.translation]} {pattern}.</question>
      <answer>{context[.kana]}{pattern}ことが{verb[id:dekiru]}</answer>
    </sentence_pattern>
    <sentence_pattern id="te_iru" label="Czynność w toku 〜ている">
      <patterns form="te_form" translation="current">
        <pattern ref="simple" />
        <pattern ref="transitive_object" />
        <pattern ref="destination" />
        <pattern ref="companion" />
        <pattern ref="place" />
      </patterns>
      <question>{context[.translation]}{pattern}.</question>
      <answer>{context[.kana]}{pattern}{verb[id:iru]}</answer>
    </sentence_pattern>
  </sentence_patterns>
</sentence_maps>
