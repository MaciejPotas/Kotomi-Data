<?xml version='1.0' encoding='utf-8'?>
<counting schema_version="2" source_language="pl">
  <number_composition min="1" max="99999999">
    <digits>
      <digit value="1" kana="いち" kanji="一" romaji="ichi" />
      <digit value="2" kana="に" kanji="二" romaji="ni" />
      <digit value="3" kana="さん" kanji="三" romaji="san" />
      <digit value="4" kana="よん" kanji="四" romaji="yon" />
      <digit value="5" kana="ご" kanji="五" romaji="go" />
      <digit value="6" kana="ろく" kanji="六" romaji="roku" />
      <digit value="7" kana="なな" kanji="七" romaji="nana" />
      <digit value="8" kana="はち" kanji="八" romaji="hachi" />
      <digit value="9" kana="きゅう" kanji="九" romaji="kyuu" />
    </digits>
    <units>
      <unit value="10" kana="じゅう" kanji="十" romaji="juu" />
      <unit value="100" kana="ひゃく" kanji="百" romaji="hyaku">
        <variant multiplier="3" kana="さんびゃく" kanji="三百" romaji="sanbyaku" />
        <variant multiplier="6" kana="ろっぴゃく" kanji="六百" romaji="roppyaku" />
        <variant multiplier="8" kana="はっぴゃく" kanji="八百" romaji="happyaku" />
      </unit>
      <unit value="1000" kana="せん" kanji="千" romaji="sen">
        <variant multiplier="3" kana="さんぜん" kanji="三千" romaji="sanzen" />
        <variant multiplier="8" kana="はっせん" kanji="八千" romaji="hassen" />
      </unit>
      <unit value="10000" kana="まん" kanji="万" romaji="man" omit_one="false" />
    </units>
  </number_composition>
  <counter_composition_profiles>
    <profile id="nin" kana="にん" kanji="人" romaji="nin" />
    <profile id="hiki" kana="ひき" kanji="匹" romaji="hiki">
      <variant multiplier="0" kana="じゅっぴき" kanji="十匹" romaji="juppiki" />
      <variant multiplier="1" kana="いっぴき" kanji="一匹" romaji="ippiki" />
      <variant multiplier="3" kana="さんびき" kanji="三匹" romaji="sanbiki" />
      <variant multiplier="6" kana="ろっぴき" kanji="六匹" romaji="roppiki" />
      <variant multiplier="8" kana="はっぴき" kanji="八匹" romaji="happiki" />
    </profile>
    <profile id="hon" kana="ほん" kanji="本" romaji="hon">
      <variant multiplier="0" kana="じゅっぽん" kanji="十本" romaji="juppon" />
      <variant multiplier="1" kana="いっぽん" kanji="一本" romaji="ippon" />
      <variant multiplier="3" kana="さんぼん" kanji="三本" romaji="sanbon" />
      <variant multiplier="6" kana="ろっぽん" kanji="六本" romaji="roppon" />
      <variant multiplier="8" kana="はっぽん" kanji="八本" romaji="happon" />
    </profile>
    <profile id="mai" kana="まい" kanji="枚" romaji="mai" />
    <profile id="satsu" kana="さつ" kanji="冊" romaji="satsu">
      <variant multiplier="0" kana="じゅっさつ" kanji="十冊" romaji="jussatsu" />
      <variant multiplier="1" kana="いっさつ" kanji="一冊" romaji="issatsu" />
      <variant multiplier="8" kana="はっさつ" kanji="八冊" romaji="hassatsu" />
    </profile>
    <profile id="dai" kana="だい" kanji="台" romaji="dai" />
    <profile id="ko" kana="こ" kanji="個" romaji="ko">
      <variant multiplier="0" kana="じゅっこ" kanji="十個" romaji="jukko" />
      <variant multiplier="1" kana="いっこ" kanji="一個" romaji="ikko" />
      <variant multiplier="6" kana="ろっこ" kanji="六個" romaji="rokko" />
      <variant multiplier="8" kana="はっこ" kanji="八個" romaji="hakko" />
