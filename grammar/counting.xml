    <profile id="ji" kana="じ" kanji="時" romaji="ji">
      <variant multiplier="4" kana="よじ" kanji="四時" romaji="yoji" />
      <variant multiplier="7" kana="しちじ" kanji="七時" romaji="shichiji" />
      <variant multiplier="9" kana="くじ" kanji="九時" romaji="kuji" />
