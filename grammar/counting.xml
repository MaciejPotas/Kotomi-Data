    <class id="small_object" label="Małe przedmioty" default_counter="ko">
      <counter ref="ko" />
    </class>
  </counting_classes>
  <count_source_profiles>
    <profiles>
      <profile id="one" label="jeden" fallback="noun_case" source_agreement="singular" />
      <profile id="few" label="kilka" source_form_strategy="paucal" source_agreement="plural" />
      <profile id="many" label="wiele lub ile" source_form_strategy="genitive_plural" source_agreement="singular" />
    </profiles>
    <quantity_mappings>
      <quantity number="1" profile="one" />
      <range min="2" max="4" profile="few" />
      <range min="5" max="*" profile="many" />
      <quantity symbol="how_many" profile="many" />
    </quantity_mappings>
  </count_source_profiles>
  <number_sets>
    <set id="one_to_ten" label="Liczby od 1 do 10">
