<?xml version='1.0' encoding='utf-8'?>
<counting schema_version="2" source_language="pl" shared_target="../shared/ja/counting.xml">
  <counting_classes>
    <class id="person" label="Osoby" />
    <class id="small_animal" label="Małe zwierzęta" />
    <class id="long_object" label="Długie przedmioty" />
    <class id="flat_object" label="Płaskie przedmioty" />
    <class id="bound_volume" label="Oprawione tomy" />
    <class id="machine" label="Maszyny i pojazdy" />
    <class id="small_object" label="Małe przedmioty" />
  </counting_classes>
  <count_source_profiles>
    <profiles>
      <profile id="one" label="jeden" fallback="noun_case" source_agreement="singular" />
      <profile id="few" label="kilka" source_form_strategy="paucal" source_agreement="plural" />
      <profile id="many" label="wiele lub ile" source_form_strategy="genitive_plural" source_agreement="singular" />
    </profiles>
    <quantity_mappings>
      <quantity number="1" profile="one" />
      <rule min="2" max="*" modulo="10" remainder_min="2" remainder_max="4" exclude_modulo="100" exclude_remainder_min="12" exclude_remainder_max="14" profile="few" />
      <range min="2" max="*" profile="many" />
      <quantity symbol="how_many" profile="many" />
    </quantity_mappings>
  </count_source_profiles>
  <number_sets>
    <set id="one_to_ten" label="Liczby od 1 do 10" />
    <set id="two_to_four" label="Liczby od 2 do 4" />
    <set id="two_or_more" label="Dwa lub więcej" />
  </number_sets>
</counting>