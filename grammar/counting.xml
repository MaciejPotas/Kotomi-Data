      <variant multiplier="1" kana="いっぷん" kanji="一分" romaji="ippun" />
      <variant multiplier="3" kana="さんぷん" kanji="三分" romaji="sanpun" />
      <variant multiplier="4" kana="よんぷん" kanji="四分" romaji="yonpun" />
