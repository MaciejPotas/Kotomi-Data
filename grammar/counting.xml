      <variant multiplier="1" kana="いっさい" kanji="一歳" romaji="issai" />
      <variant multiplier="8" kana="はっさい" kanji="八歳" romaji="hassai" />
    </profile>
    <profile id="kai" kana="かい" kanji="階" romaji="kai">
      <variant multiplier="0" kana="じゅっかい" kanji="十階" romaji="jukkai" />
      <variant multiplier="1" kana="いっかい" kanji="一階" romaji="ikkai" />
      <variant multiplier="3" kana="さんがい" kanji="三階" romaji="sangai" />
      <variant multiplier="6" kana="ろっかい" kanji="六階" romaji="rokkai" />
      <variant multiplier="8" kana="はっかい" kanji="八階" romaji="hakkai" />
    </profile>
  </counter_composition_profiles>
  <counting_classes>
    <class id="person" label="Osoby" default_counter="nin">
      <counter ref="nin" />
    </class>
    <class id="small_animal" label="Małe zwierzęta" default_counter="hiki">
      <counter ref="hiki" />
    </class>
    <class id="long_object" label="Długie przedmioty" default_counter="hon">
