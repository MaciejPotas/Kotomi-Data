<?xml version='1.0' encoding='utf-8'?>
<grammar_rules schema_version="2" instruction_language_id="pl" shared_target="../shared/ja/grammar.xml">
  <noun_categories>
    <category id="concrete" label="Concrete" />
    <category id="person" label="Person" />
    <category id="animal" label="Animal" />
    <category id="place" label="Place" />
    <category id="purchasable" label="Purchasable" />
    <category id="food" label="Food" />
    <category id="drink" label="Drink" />
    <category id="text" label="Text" />
    <category id="media" label="Audible media" />
    <category id="vehicle" label="Vehicle" />
    <category id="thing" label="Thing" />
    <category id="item" label="Item" />
    <category id="abstract" label="Abstract" />
    <category id="availability_reason" label="Availability reason" />
  </noun_categories>
  <form_catalogs>
    <form_catalog schema="verb">
      <form name="dictionary" label="forma słownikowa" />
      <form name="polite_nonpast" label="uprzejma nieprzeszła" />
      <form name="plain_negative" label="potoczna przecząca" />
      <form name="polite_negative" label="uprzejma przecząca" />
      <form name="past_plain" label="potoczna przeszła" />
      <form name="past_polite" label="uprzejma przeszła" />
      <form name="past_negative_plain" label="potoczna przeszła przecząca" />
      <form name="past_negative_polite" label="uprzejma przeszła przecząca" />
      <form name="te_form" label="forma て" />
      <form name="potential" label="potencjalna" />
      <form name="passive" label="bierna" />
      <form name="causative" label="kauzatywna" />
      <form name="tara" label="warunkowa" lesson_name="conditional" />
      <form name="volitional" label="wolicjonalna" />
      <form name="imperative" label="rozkazująca" />
    </form_catalog>
    <form_catalog schema="adjective">
      <form name="predicate_plain_nonpast" label="orzecznikowa potoczna nieprzeszła" />
      <form name="predicate_polite_nonpast" label="orzecznikowa uprzejma nieprzeszła" />
      <form name="predicate_plain_negative" label="orzecznikowa potoczna przecząca" />
      <form name="predicate_polite_negative" label="orzecznikowa uprzejma przecząca" />
      <form name="predicate_plain_past" label="orzecznikowa potoczna przeszła" />
      <form name="predicate_polite_past" label="orzecznikowa uprzejma przeszła" />
      <form name="predicate_plain_past_negative" label="orzecznikowa potoczna przeszła przecząca" />
      <form name="predicate_polite_past_negative" label="orzecznikowa uprzejma przeszła przecząca" />
      <form name="attributive_nonpast" label="przydawkowa nieprzeszła" />
      <form name="connective" label="łącząca" />
      <form name="adverbial" label="przysłówkowa" />
      <form name="conditional" label="warunkowa" />
      <form name="nominalized" label="nominalizowana" />
      <form name="appearance_sou" label="wygląd 〜そう" />
      <form name="excessive_sugiru" label="nadmiar 〜すぎる" />
    </form_catalog>
    <form_catalog schema="copula">
      <form name="dictionary" label="forma słownikowa" />
      <form name="polite_nonpast" label="uprzejma nieprzeszła" />
      <form name="plain_negative" label="potoczna przecząca" />
      <form name="polite_negative" label="uprzejma przecząca" />
      <form name="past_plain" label="potoczna przeszła" />
      <form name="past_polite" label="uprzejma przeszła" />
      <form name="past_negative_plain" label="potoczna przeszła przecząca" />
      <form name="past_negative_polite" label="uprzejma przeszła przecząca" />
    </form_catalog>
  </form_catalogs>
  <agreement_catalogs>
    <agreement_catalog schema="adjective" form="attributive_nonpast" default_case_ref="nominative" fallback="translation">
      <template value="{value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_plain_nonpast" default_case_ref="nominative" fallback="translation">
      <template value="jest {value}" />
      <template classes="plural_non_masculine_personal" value="są {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_polite_nonpast" default_case_ref="nominative" fallback="translation">
      <template value="jest {value}" />
      <template classes="plural_non_masculine_personal" value="są {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_plain_negative" default_case_ref="nominative" fallback="translation">
      <template value="nie jest {value}" />
      <template classes="plural_non_masculine_personal" value="nie są {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_polite_negative" default_case_ref="nominative" fallback="translation">
      <template value="nie jest {value}" />
      <template classes="plural_non_masculine_personal" value="nie są {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_plain_past" default_case_ref="nominative" fallback="translation">
      <template value="był {value}" />
      <template classes="feminine" value="była {value}" />
      <template classes="neuter" value="było {value}" />
      <template classes="plural_non_masculine_personal" value="były {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_polite_past" default_case_ref="nominative" fallback="translation">
      <template value="był {value}" />
      <template classes="feminine" value="była {value}" />
      <template classes="neuter" value="było {value}" />
      <template classes="plural_non_masculine_personal" value="były {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_plain_past_negative" default_case_ref="nominative" fallback="translation">
      <template value="nie był {value}" />
      <template classes="feminine" value="nie była {value}" />
      <template classes="neuter" value="nie było {value}" />
      <template classes="plural_non_masculine_personal" value="nie były {value}" />
    </agreement_catalog>
    <agreement_catalog schema="adjective" form="predicate_polite_past_negative" default_case_ref="nominative" fallback="translation">
      <template value="nie był {value}" />
      <template classes="feminine" value="nie była {value}" />
      <template classes="neuter" value="nie było {value}" />
      <template classes="plural_non_masculine_personal" value="nie były {value}" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="dictionary" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="jest" />
      <template classes="plural_non_masculine_personal" value="są" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="polite_nonpast" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="jest" />
      <template classes="plural_non_masculine_personal" value="są" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="plain_negative" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="nie jest" />
      <template classes="plural_non_masculine_personal" value="nie są" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="polite_negative" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="nie jest" />
      <template classes="plural_non_masculine_personal" value="nie są" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="past_plain" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="był" />
      <template classes="feminine" value="była" />
      <template classes="neuter" value="było" />
      <template classes="plural_non_masculine_personal" value="były" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="past_polite" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="był" />
      <template classes="feminine" value="była" />
      <template classes="neuter" value="było" />
      <template classes="plural_non_masculine_personal" value="były" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="past_negative_plain" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="nie był" />
      <template classes="feminine" value="nie była" />
      <template classes="neuter" value="nie było" />
      <template classes="plural_non_masculine_personal" value="nie były" />
    </agreement_catalog>
    <agreement_catalog schema="copula" form="past_negative_polite" default_case_ref="nominative" fallback="translation" lexical="false">
      <template value="nie był" />
      <template classes="feminine" value="nie była" />
      <template classes="neuter" value="nie było" />
      <template classes="plural_non_masculine_personal" value="nie były" />
    </agreement_catalog>
    <agreement_catalog schema="interrogative" default_case_ref="nominative" fallback="translation">
      <template value="{value}" />
    </agreement_catalog>
    <agreement_catalog schema="number" default_case_ref="nominative" fallback="translation">
      <template value="{value}" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="dictionary" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="jest" />
      <template classes="singular" value="Jest" />
      <template classes="plural" value="Są" />
      <template classes="plural_non_masculine_personal" value="są" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="polite_nonpast" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="jest" />
      <template classes="singular" value="Jest" />
      <template classes="plural" value="Są" />
      <template classes="plural_non_masculine_personal" value="są" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="plain_negative" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="nie ma" />
      <template classes="singular plural" value="Nie ma" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="polite_negative" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="nie ma" />
      <template classes="singular plural" value="Nie ma" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="past_plain" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="był" />
      <template classes="feminine" value="była" />
      <template classes="neuter" value="było" />
      <template classes="plural_non_masculine_personal" value="były" />
      <template classes="singular" value="Był" />
      <template classes="plural" value="Były" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="past_polite" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="był" />
      <template classes="feminine" value="była" />
      <template classes="neuter" value="było" />
      <template classes="plural_non_masculine_personal" value="były" />
      <template classes="singular" value="Był" />
      <template classes="plural" value="Były" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="past_negative_plain" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="nie było" />
      <template classes="singular plural" value="Nie było" />
    </agreement_catalog>
    <agreement_catalog schema="verb" form="past_negative_polite" default_case_ref="nominative" fallback="translation" lexical="false" features="existential">
      <template value="nie było" />
      <template classes="singular plural" value="Nie było" />
    </agreement_catalog>
  </agreement_catalogs>
  <noun_case_by_form>
    <map polarity="affirmative" case_ref="accusative" />
    <map polarity="negative" case_ref="genitive" />
  </noun_case_by_form>
  <polish_noun_relations>
    <profile id="place_w_do">
      <realization relation="location" case_ref="locative" preposition="w" />
      <realization relation="destination" case_ref="genitive" preposition="do" />
    </profile>
    <profile id="place_na_na">
      <realization relation="location" case_ref="locative" preposition="na" />
      <realization relation="destination" case_ref="accusative" preposition="na" />
    </profile>
    <profile id="place_we_do">
      <realization relation="location" case_ref="locative" preposition="we" />
      <realization relation="destination" case_ref="genitive" preposition="do" />
    </profile>
  </polish_noun_relations>
  <polish_clitics>
    <clitic value="się" />
  </polish_clitics>
  <polish_government>
    <frame id="direct_object">
      <realization polarity="affirmative" case_ref="accusative" />
      <realization polarity="negative" case_ref="genitive" />
    </frame>
    <frame id="existential_subject">
      <realization polarity="affirmative" case_ref="nominative" />
      <realization polarity="negative" case_ref="genitive" />
    </frame>
    <frame id="genitive">
      <realization polarity="any" case_ref="genitive" />
    </frame>
    <frame id="w_accusative">
      <realization polarity="any" case_ref="accusative" preposition="w" />
    </frame>
    <frame id="instrumental_object">
      <realization polarity="any" case_ref="instrumental" />
    </frame>
    <frame id="z_instrumental">
      <realization polarity="any" case_ref="instrumental" preposition="z" />
    </frame>
    <frame id="na_accusative">
      <realization polarity="any" case_ref="accusative" preposition="na" />
    </frame>
    <frame id="nad_instrumental">
      <realization polarity="any" case_ref="instrumental" preposition="nad" />
    </frame>
    <frame id="o_locative">
      <realization polarity="any" case_ref="locative" preposition="o" />
    </frame>
    <frame id="z_genitive">
      <realization polarity="any" case_ref="genitive" preposition="z" />
    </frame>
  </polish_government>
  <roles>
    <role id="object" label="Object" />
    <role id="route" label="Route or point of departure" />
    <role id="location" label="Location" />
    <role id="destination" label="Destination" />
    <role id="companion" label="Companion" />
    <role id="target" label="Target" />
    <role id="vehicle" label="Vehicle" />
    <role id="subject" label="Subject" />
    <role id="reaction_target" label="Reaction target" />
  </roles>
  <features>
    <feature id="reporting" label="Reporting verb" />
    <feature id="progressive_auxiliary" label="Progressive auxiliary" />
    <feature id="existential" label="Existential verb" />
  </features>
</grammar_rules>