<?xml version='1.0' encoding='utf-8'?>
<grammar_rules schema_version="1">
  <!--
    NOUN CATEGORIES

    id:
      Stable machine identifier used by dictionaries, roles and pattern rules.

    label:
      Human-readable name used by authoring/UI tools.

    parent:
      Optional parent category. Categories inherit compatibility from their
      ancestors, so a "person" can also satisfy rules accepting "concrete".

    selectable:
      Controls whether the category is offered directly in authoring/selectors.
      Non-selectable categories may still be useful as grouping parents.
  -->
  <noun_categories>
    <category id="concrete" label="Concrete" selectable="false" />
    <category id="person" label="Person" parent="concrete" selectable="true" />
    <category id="animal" label="Animal" parent="concrete" selectable="true" />
    <category id="place" label="Place" parent="concrete" selectable="true" />
    <category id="food" label="Food" parent="concrete" selectable="true" />
    <category id="drink" label="Drink" parent="concrete" selectable="true" />
    <category id="text" label="Text" parent="concrete" selectable="true" />
    <category id="media" label="Audible media" selectable="true" />
    <category id="vehicle" label="Vehicle" parent="concrete" selectable="true" />
    <category id="thing" label="Thing" parent="concrete" selectable="true" />
    <category id="abstract" label="Abstract" selectable="true" />
    <category id="availability_reason" label="Availability reason" parent="abstract" selectable="true" />
  </noun_categories>
  <!--
    FORM CATALOGS

    A form catalog describes grammar semantics once per schema. Word XML files
    store only the realized values and reference these definitions by name.

    form_catalog schema:
      Selects the word schema that owns the forms, for example verb,
      adjective or copula.

    form/name:
      Stable machine identifier. It is used by <form ref="..."> in dictionary
      data and by pattern selectors such as [form:dictionary].

    form/label:
      Human-readable label used by Studio, lesson UI and quiz form selectors.
      It is presentation metadata, not grammar logic.

    form/lesson_name:
      Optional persisted lesson alias used only when the lesson data format
      needs a different external name. Example: verb "tara" is stored in
      lessons as "conditional". If omitted, lesson_name is the same as name.

    form/context:
      Grammar context used by sentence generation. Finite forms use a real
      context such as "present" or "past". Derived or non-finite forms that do
      not independently express tense/polarity/register use context="none".

    form/polarity:
      "affirmative" or "negative". It is defined only for finite forms.
      [polarity:affirmative] and [polarity:negative] change this dimension while
      preserving context and register.

    form/register:
      "plain" or "polite". It is defined only for finite forms and is preserved
      when polarity is changed.

    FINITE FORM RULE:
      A standard finite/selectable form is derived automatically from metadata.
      It must define all three values:
        context != "none" + polarity + register

      No separate quiz/selectable flag is stored because selectability can be
      derived from those three grammar properties.

    POLARITY PAIR RULE:
      Within one schema, every finite (context, register) pair must contain
      exactly one affirmative and one negative form. Therefore an explicit
      polarity_group is unnecessary.

    DERIVED AND NON-FINITE FORMS:
      Forms such as te_form, potential, passive, causative, tara, volitional,
      imperative, attributive, connective and similar forms currently use
      context="none". They intentionally omit polarity and register because
      this form entry represents the derived form itself, not a complete
      finite affirmative/negative or plain/polite paradigm.
  -->
  <form_catalogs>
    <form_catalog schema="verb">
      <form name="dictionary" label="forma słownikowa" context="present" polarity="affirmative" register="plain" />
      <form name="polite_nonpast" label="uprzejma nieprzeszła" context="present" polarity="affirmative" register="polite" />
      <form name="plain_negative" label="potoczna przecząca" context="present" polarity="negative" register="plain" />
      <form name="polite_negative" label="uprzejma przecząca" context="present" polarity="negative" register="polite" />
      <form name="past_plain" label="potoczna przeszła" context="past" polarity="affirmative" register="plain" />
      <form name="past_polite" label="uprzejma przeszła" context="past" polarity="affirmative" register="polite" />
      <form name="past_negative_plain" label="potoczna przeszła przecząca" context="past" polarity="negative" register="plain" />
      <form name="past_negative_polite" label="uprzejma przeszła przecząca" context="past" polarity="negative" register="polite" />
      <form name="te_form" label="forma て" context="none" />
      <form name="potential" label="potencjalna" context="none" />
      <form name="passive" label="bierna" context="none" />
      <form name="causative" label="kauzatywna" context="none" />
      <form name="tara" label="warunkowa" lesson_name="conditional" context="none" />
      <form name="volitional" label="wolicjonalna" context="none" />
      <form name="imperative" label="rozkazująca" context="none" />
    </form_catalog>
    <form_catalog schema="adjective">
      <form name="predicate_plain_nonpast" label="orzecznikowa potoczna nieprzeszła" context="present" polarity="affirmative" register="plain" />
      <form name="predicate_polite_nonpast" label="orzecznikowa uprzejma nieprzeszła" context="present" polarity="affirmative" register="polite" />
      <form name="predicate_plain_negative" label="orzecznikowa potoczna przecząca" context="present" polarity="negative" register="plain" />
      <form name="predicate_polite_negative" label="orzecznikowa uprzejma przecząca" context="present" polarity="negative" register="polite" />
      <form name="predicate_plain_past" label="orzecznikowa potoczna przeszła" context="past" polarity="affirmative" register="plain" />
      <form name="predicate_polite_past" label="orzecznikowa uprzejma przeszła" context="past" polarity="affirmative" register="polite" />
      <form name="predicate_plain_past_negative" label="orzecznikowa potoczna przeszła przecząca" context="past" polarity="negative" register="plain" />
      <form name="predicate_polite_past_negative" label="orzecznikowa uprzejma przeszła przecząca" context="past" polarity="negative" register="polite" />
      <form name="attributive_nonpast" label="przydawkowa nieprzeszła" context="none" />
      <form name="connective" label="łącząca" context="none" />
      <form name="adverbial" label="przysłówkowa" context="none" />
      <form name="conditional" label="warunkowa" context="none" />
      <form name="nominalized" label="nominalizowana" context="none" />
      <form name="appearance_sou" label="wygląd 〜そう" context="none" />
      <form name="excessive_sugiru" label="nadmiar 〜すぎる" context="none" />
    </form_catalog>
    <form_catalog schema="copula">
      <form name="dictionary" label="forma słownikowa" context="present" polarity="affirmative" register="plain" />
      <form name="polite_nonpast" label="uprzejma nieprzeszła" context="present" polarity="affirmative" register="polite" />
      <form name="plain_negative" label="potoczna przecząca" context="present" polarity="negative" register="plain" />
      <form name="polite_negative" label="uprzejma przecząca" context="present" polarity="negative" register="polite" />
      <form name="past_plain" label="potoczna przeszła" context="past" polarity="affirmative" register="plain" />
      <form name="past_polite" label="uprzejma przeszła" context="past" polarity="affirmative" register="polite" />
      <form name="past_negative_plain" label="potoczna przeszła przecząca" context="past" polarity="negative" register="plain" />
      <form name="past_negative_polite" label="uprzejma przeszła przecząca" context="past" polarity="negative" register="polite" />
    </form_catalog>
  </form_catalogs>
  <!--
    DYNAMIC NOUN CASE BY FORM

    Used by noun placeholders with [case:form].

    The engine first resolves the grammar schema of the slot governing the
    noun, reads the selected finite form's polarity, and maps that polarity to
    a concrete noun case below.

    Example:
      affirmative -> accusative
      negative    -> genitive

    This mapping is global because the semantic dimension is polarity, while
    the actual polarity value comes from the governing form's schema.
  -->
  <noun_case_by_form>
    <map polarity="affirmative" case_ref="accusative" />
    <map polarity="negative" case_ref="genitive" />
  </noun_case_by_form>
  <!--
    POLISH VERB GOVERNMENT

    These frames describe only the Polish realization of a verb argument.
    Japanese roles continue to select particles and compatible vocabulary.
    A verb usage entry references one frame with government="...".

    polarity:
      "affirmative" or "negative" selects a form-specific realization.
      "any" applies to both polarities.

    preposition:
      Optional Polish preposition emitted before the declined noun.
  -->
  <polish_government>
    <frame id="direct_object" language="pl">
      <realization polarity="affirmative" case_ref="accusative" />
      <realization polarity="negative" case_ref="genitive" />
    </frame>
    <frame id="genitive_object" language="pl">
      <realization polarity="any" case_ref="genitive" />
    </frame>
    <frame id="dative_object" language="pl">
      <realization polarity="any" case_ref="dative" />
    </frame>
    <frame id="instrumental_object" language="pl">
      <realization polarity="any" case_ref="instrumental" />
    </frame>
    <frame id="na_accusative" language="pl">
      <realization polarity="any" case_ref="accusative" preposition="na" />
    </frame>
    <frame id="nad_instrumental" language="pl">
      <realization polarity="any" case_ref="instrumental" preposition="nad" />
    </frame>
    <frame id="o_locative" language="pl">
      <realization polarity="any" case_ref="locative" preposition="o" />
    </frame>
    <frame id="z_genitive" language="pl">
      <realization polarity="any" case_ref="genitive" preposition="z" />
    </frame>
  </polish_government>
  <!--
    ROLES

    id:
      Stable semantic role identifier used by word usage rules and patterns.

    label:
      Human-readable authoring label.

    particle:
      Japanese particle emitted for the role when applicable.

    accepts:
      Optional whitespace-separated noun categories allowed for the role.
      If omitted, the role is not restricted to selected noun categories.
  -->
  <roles>
    <role id="object" label="Object" particle="を" />
    <role id="route" label="Route or point of departure" particle="を" accepts="place" />
    <role id="location" label="Location" particle="で" accepts="place" />
    <role id="destination" label="Destination" particle="へ" accepts="place" />
    <role id="companion" label="Companion" particle="と" accepts="person animal" />
    <role id="target" label="Target" particle="に" />
    <role id="vehicle" label="Vehicle" particle="に" accepts="vehicle" />
    <role id="subject" label="Subject" particle="が" />
    <role id="reaction_target" label="Reaction target" particle="に" />
  </roles>
  <!--
    FEATURES

    Semantic capabilities attached to words. Patterns and generation logic may
    require a feature without encoding that knowledge in a concrete word list.

    id:
      Stable machine identifier.

    label:
      Human-readable description used by authoring tools.
  -->
  <features>
    <feature id="reporting" label="Reporting verb" />
    <feature id="progressive_auxiliary" label="Progressive auxiliary" />
  </features>
</grammar_rules>