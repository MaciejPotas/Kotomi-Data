<?xml version='1.0' encoding='utf-8'?>
<grammar_rules schema_version="1">
  <noun_categories>
    <category id="concrete" label="Concrete" selectable="false" />
    <category id="person" label="Person" parent="concrete" selectable="true" />
    <category id="animal" label="Animal" parent="concrete" selectable="true" />
    <category id="place" label="Place" parent="concrete" selectable="true" />
    <category id="food" label="Food" parent="concrete" selectable="true" />
    <category id="drink" label="Drink" parent="concrete" selectable="true" />
    <category id="text" label="Text" parent="concrete" selectable="true" />
    <category id="media" label="Audible media" selectable="true" />
    <category id="vehicle" label="Vehicle" parent="concrete" selectable="true" />
    <category id="thing" label="Thing" parent="concrete" selectable="true" />
    <category id="abstract" label="Abstract" selectable="true" />
    <category id="availability_reason" label="Availability reason" parent="abstract" selectable="true" />
  </noun_categories>
  <form_catalogs>
    <form_catalog schema="verb">
      <form name="dictionary" context="present" style="potoczna" polarity="affirmative" register="plain" quiz="true" />
      <form name="polite_nonpast" context="present" style="uprzejma" polarity="affirmative" register="polite" quiz="true" />
      <form name="plain_negative" context="present" style="potoczna przecząca" polarity="negative" register="plain" quiz="true" />
      <form name="polite_negative" context="present" style="uprzejma przecząca" polarity="negative" register="polite" quiz="true" />
      <form name="past_plain" context="past" style="potoczna przeszła" polarity="affirmative" register="plain" quiz="true" />
      <form name="past_polite" context="past" style="uprzejma przeszła" polarity="affirmative" register="polite" quiz="true" />
      <form name="past_negative_plain" context="past" style="potoczna przeszła przecząca" polarity="negative" register="plain" quiz="true" />
      <form name="past_negative_polite" context="past" style="uprzejma przeszła przecząca" polarity="negative" register="polite" quiz="true" />
      <form name="te_form" context="none" style="forma て" />
      <form name="potential" context="none" style="potencjalna" />
      <form name="passive" context="none" style="bierna" />
      <form name="causative" context="none" style="kauzatywna" />
      <form name="tara" context="none" style="warunkowa たら" />
      <form name="volitional" context="none" style="wolicjonalna" />
      <form name="imperative" context="none" style="rozkazująca" />
    </form_catalog>
    <form_catalog schema="adjective">
      <form name="predicate_plain_nonpast" context="present" style="plain non-past" polarity="affirmative" register="plain" quiz="true" />
      <form name="predicate_polite_nonpast" context="present" style="polite non-past" polarity="affirmative" register="polite" quiz="true" />
      <form name="predicate_plain_negative" context="present" style="plain negative" polarity="negative" register="plain" quiz="true" />
      <form name="predicate_polite_negative" context="present" style="polite negative" polarity="negative" register="polite" quiz="true" />
      <form name="predicate_plain_past" context="past" style="plain past" polarity="affirmative" register="plain" quiz="true" />
      <form name="predicate_polite_past" context="past" style="polite past" polarity="affirmative" register="polite" quiz="true" />
      <form name="predicate_plain_past_negative" context="past" style="plain past negative" polarity="negative" register="plain" quiz="true" />
      <form name="predicate_polite_past_negative" context="past" style="polite past negative" polarity="negative" register="polite" quiz="true" />
      <form name="attributive_nonpast" context="none" style="before noun" />
      <form name="connective" context="none" style="connective" />
      <form name="adverbial" context="none" style="adverbial" />
      <form name="conditional" context="none" style="conditional" />
      <form name="nominalized" context="none" style="nominalized noun" />
      <form name="appearance_sou" context="none" style="looks" />
      <form name="excessive_sugiru" context="none" style="too much" />
    </form_catalog>
    <form_catalog schema="copula">
      <form name="dictionary" context="present" style="plain non-past" polarity="affirmative" register="plain" quiz="true" />
      <form name="polite_nonpast" context="present" style="polite non-past" polarity="affirmative" register="polite" quiz="true" />
      <form name="plain_negative" context="present" style="plain negative" polarity="negative" register="plain" quiz="true" />
      <form name="polite_negative" context="present" style="polite negative" polarity="negative" register="polite" quiz="true" />
      <form name="past_plain" context="past" style="plain past" polarity="affirmative" register="plain" quiz="true" />
      <form name="past_polite" context="past" style="polite past" polarity="affirmative" register="polite" quiz="true" />
      <form name="past_negative_plain" context="past" style="plain past negative" polarity="negative" register="plain" quiz="true" />
      <form name="past_negative_polite" context="past" style="polite past negative" polarity="negative" register="polite" quiz="true" />
    </form_catalog>
  </form_catalogs>
  <form_sets>
    <form_set id="affirmative">
      <form ref="dictionary" />
      <form ref="polite_nonpast" />
      <form ref="past_plain" />
      <form ref="past_polite" />
    </form_set>
    <form_set id="negative">
      <form ref="plain_negative" />
      <form ref="polite_negative" />
      <form ref="past_negative_plain" />
      <form ref="past_negative_polite" />
    </form_set>
  </form_sets>
  <noun_case_by_form>
    <map form_ref="affirmative" case_ref="accusative" />
    <map form_ref="negative" case_ref="genitive" />
  </noun_case_by_form>
  <roles>
    <role id="object" label="Object" particle="を" />
    <role id="route" label="Route or point of departure" particle="を" accepts="place" />
    <role id="location" label="Location" particle="で" accepts="place" />
    <role id="destination" label="Destination" particle="へ" accepts="place" />
    <role id="companion" label="Companion" particle="と" accepts="person animal" />
    <role id="target" label="Target" particle="に" />
    <role id="vehicle" label="Vehicle" particle="に" accepts="vehicle" />
    <role id="subject" label="Subject" particle="が" />
    <role id="reaction_target" label="Reaction target" particle="に" />
  </roles>
  <features>
    <feature id="reporting" label="Reporting verb" />
    <feature id="progressive_auxiliary" label="Progressive auxiliary" />
  </features>
</grammar_rules>